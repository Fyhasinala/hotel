<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


   <children>
      <HBox alignment="BOTTOM_LEFT" prefHeight="57.0" prefWidth="825.0">
         <children>
            <Label alignment="CENTER" prefHeight="62.0" prefWidth="344.0" text="Liste des réservations">
               <font>
                  <Font size="32.0" />
               </font>
            </Label>
         </children>
      </HBox>
      <HBox alignment="TOP_RIGHT" prefHeight="42.0" prefWidth="825.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="43.0" prefWidth="89.0">
               <children>
                  <Button fx:id="modif" onAction="#popup" mnemonicParsing="false" text="Modifier" />
               </children></HBox>
            <HBox alignment="CENTER_LEFT" prefHeight="32.0" prefWidth="67.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#occup" text="Occuper" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefHeight="32.0" prefWidth="74.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#suppr" text="Annuler" />
               </children>
            </HBox>
         </children>
      </HBox>
      <TableView fx:id="resTable" prefHeight="516.0" prefWidth="858.0">
        <columns>
          <TableColumn fx:id="id" prefWidth="75.0" resizable="false" text="Id " />
            <TableColumn fx:id="cham" prefWidth="75.0" resizable="false" text="Chambre " />
            <TableColumn fx:id="dateres" prefWidth="122.0" resizable="false" text="Date de réservation" />
            <TableColumn fx:id="entree" prefWidth="137.0" resizable="false" text="Date d'entrée" />
            <TableColumn fx:id="nom" prefWidth="75.0" resizable="false" text="Client " />
            <TableColumn fx:id="cl" minWidth="3.0" prefWidth="158.0" resizable="false" text="Numero" />
            <TableColumn fx:id="email" minWidth="0.0" prefWidth="160.0" resizable="false" text="Email" />
            <TableColumn fx:id="dure" prefWidth="92.0" resizable="false" text="Durée prévue" />
            
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
