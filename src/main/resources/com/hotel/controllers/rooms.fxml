<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<fx:root prefHeight="150" prefWidth="200" type="javafx.scene.layout.StackPane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../style.css
">

    <!-- 1. Top Badges (Left & Right corners) -->
    <Label fx:id="design" alignment="CENTER" prefHeight="40" prefWidth="120" style="-fx-font-weight: bold; -fx-padding: 0 0 0 15;" StackPane.alignment="TOP_LEFT" />
    <Label fx:id="status" alignment="CENTER" prefHeight="40" prefWidth="40" style="-fx-font-weight: bold; -fx-padding: 0 15 0 0;" StackPane.alignment="TOP_RIGHT" />

    <!-- 2. Clean Center Display Layout (Groups Room Details Vertically to prevent collisions) -->
    <VBox alignment="CENTER" spacing="5" StackPane.alignment="CENTER" style="-fx-padding: 25 0 25 0;">
        <Label fx:id="type" alignment="CENTER" style="-fx-font-size: 24; -fx-font-weight: 900;" text="TYPE" />
        <Label fx:id="number" alignment="CENTER" style="-fx-font-size: 20; -fx-font-weight: bold;" text="NUM" />
    </VBox>

    <!-- 3. Bottom Pricing Bar Strip -->
    <Label fx:id="price" alignment="CENTER" prefHeight="40" prefWidth="200" style="-fx-font-size: 18; -fx-font-weight: bold;" StackPane.alignment="BOTTOM_CENTER" />

</fx:root>
